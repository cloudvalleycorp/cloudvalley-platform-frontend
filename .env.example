# Copiá este archivo a .env y completá con los valores reales del proyecto
# (pedilos a otro miembro del equipo o al dashboard de Supabase). Nunca
# commitees .env: ya está en .gitignore. Ver docs/security-env-vars.md para
# el detalle de qué variable es pública y cuál no debería llegar al frontend.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-public-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_API_BASE_URL="https://api.example.com"
